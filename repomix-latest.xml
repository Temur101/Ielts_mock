      url: exam.listening_audio_parts?.part2 || exam.listening?.parts?.[1]?.audio_url || '',
      duration: exam.listening_audio_durations?.part2 || exam.listening?.parts?.[1]?.duration || '07:15',
    },
    part3: {
      partId: 3,
      title: 'Part 3: Academic Tutorial',
